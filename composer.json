{
    "name": "zephyrisle/flarum-zai-bot",
    "description": "ZAI Bot - An AI-powered bot for Flarum with OpenAI integration, @mention replies, random replies, and message extension.",
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/messages": "Enables AI replies in private messages."
    },
    "authors": [
        {
            "name": "zephyrisle",
            "homepage": "https://github.com/Zephyr-Isle"
        }
    ],
    "support": {
        "source": "https://github.com/Zephyr-Isle/flarum-zai-bot",
        "issues": "https://github.com/Zephyr-Isle/flarum-zai-bot/issues"
    },
    "autoload": {
        "psr-4": {
            "Zephyrisle\\FlarumZaiBot\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "ZAI Bot",
            "category": "feature",
            "icon": {
                "name": "fas fa-brain",
                "backgroundColor": "#87CEEB",
                "color": "#fff"
            }
        }
    }
}
