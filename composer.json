{
    "name": "zephyrisle/flarum-zai-bot",
    "description": "ZAI Bot - AI bot for Flarum with multi-account, memory, tools, cost optimization, and autonomous behavior.",
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/messages": "Enables AI replies in private messages.",
        "ramon/verified": "Enables user verification status.",
        "ramon/stickers": "Enables sticker search tool.",
        "flarum/likes": "Enables post like/unlike tool.",
        "fof/user-bio": "Enables user bio display.",
        "fof/upload": "Enables file viewing tool.",
        "datlechin/flarum-birthdays": "Enables birthday display.",
        "forumaker/profile-cover": "Enables cover image display."
    },
    "authors": [
        {
            "name": "zephyrisle",
            "homepage": "https://github.com/Zephyr-Isle"
        }
    ],
    "support": {
        "source": "https://github.com/Zephyr-Isle/flarum-zai-bot",
        "issues": "https://github.com/Zephyr-Isle/flarum-zai-bot/issues"
    },
    "autoload": {
        "psr-4": {
            "Zephyrisle\\FlarumZaiBot\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "ZAI Bot",
            "category": "feature",
            "icon": {
                "name": "fas fa-brain",
                "backgroundColor": "#87CEEB",
                "color": "#fff"
            }
        }
    }
}
